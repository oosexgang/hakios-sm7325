# Vendor firmware, extracted device data, and generated images stay local.
/uefi/files/Binaries/sm7325-device/*
!/uefi/files/Binaries/sm7325-device/README.md
/local-firmware/
/local-build/
/images/
*.ipsw
*.im4p
DeviceTree*.bin
identity.bin
*.apfs
*.dmg
*.dtb
*.dtbo
*.mbn
*.elf
*.bin
__pycache__/

# Public device firmware payloads; exclude the unique per-device GPT identity.
!/firmware/sm7325-device/**
/firmware/sm7325-device/identity/**
