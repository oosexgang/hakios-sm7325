# HakiOS installed beside Android: what U-Boot does from the boot partition of the slot Android does not run from.
# tools/mkubootimg.py --install puts this into the boot image (the HKUB container's "env"); the hakios command imports
# it over the environment built in (board/qualcomm/hakios-redwood.env) once it has taken the loader and the payload.
#
# Every start: this slot is marked successful (ABL would give up on it after seven boots otherwise), and a menu.
# Android is the default after 10 s: under HakiOS the phone does not charge, so a phone that restarts by itself ends in
# Android. Choosing Android marks this slot unbootable and restarts: ABL then makes Android's slot active itself, the
# whole way (the slots' bits, the partitions' type GUIDs, the UFS boot LUN; cmd/hakios_slot.c says why U-Boot never
# does that). Android's hakios-menu service (devices/redwood/u-boot/android/, root) or `fastboot set_active a` makes
# this slot active again, so that the next start shows this menu again.
hakios_start=run hakios_menu
hakios_menu=hakios slot successful; bootmenu 10
bootmenu_0=Android=hakios slot unbootable && hakios reboot
bootmenu_1=HakiOS (iOS)=hakios boot; pause
bootmenu_2=HakiOS over fastboot (a new kernel from the computer)=run hakios_fastboot
bootmenu_3=Fastboot (the phone's bootloader)=hakios reboot bootloader
bootmenu_4=What is in memory=hakios info; hakios slot; pause
bootmenu_5=U-Boot shell=setenv bootretry -1
bootmenu_6=Reset=hakios reboot
